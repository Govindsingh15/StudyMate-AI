# ==========================================
# StudyMate AI - Environment Configuration
# ==========================================

# Port to run Flask on (Default: 5000)
PORT=5000

# Secret key for session security
SECRET_KEY=studymate-sdg4-educational-key-2026

# ==========================================
# Google API Configuration (Recommended)
# ==========================================
# Get a free Google Gemini API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY is also supported as an alias:
GEMINI_API_KEY=your_google_api_key_here

# Selected Google Gemini Model:
# Options: gemini-1.5-flash (fast & free tier), gemini-2.0-flash, gemini-1.5-pro
GOOGLE_MODEL=gemini-1.5-flash

# ==========================================
# Optional: OpenAI API Configuration
# ==========================================
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
